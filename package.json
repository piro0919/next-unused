{
  "name": "@piro0919/next-unused",
  "version": "2.0.0",
  "description": "CLI to find unused files in your Next.js project. Works with both the app and pages routers.",
  "keywords": [
    "next",
    "nextjs",
    "unused",
    "dead-code",
    "unused-exports",
    "cli",
    "madge"
  ],
  "license": "MIT",
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/next-unused.git"
  },
  "homepage": "https://next-unused.kkweb.io",
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/next-unused/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-unused": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build:lib && pnpm run check:package",
    "dev": "next dev",
    "start": "next start",
    "build:lib": "tsup",
    "build:lib:watch": "tsup --watch",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "madge": "^8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.0.0",
    "@types/madge": "5.0.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vercel/analytics": "^2.0.1",
    "eslint": "^10.12.0",
    "lefthook": "^2.1.17",
    "next": "^16.4.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "pnpm@11.28.5"
}
