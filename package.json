{
  "name": "@piro0919/next-unused",
  "version": "1.0.0",
  "description": "CLI to find unused files in your Next.js project. Works with both the app and pages routers.",
  "keywords": [
    "next",
    "nextjs",
    "unused",
    "dead-code",
    "cli",
    "madge"
  ],
  "license": "MIT",
  "author": "piro <piro.haniwa@gmail.com> (https://kk-web.link/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/next-unused.git"
  },
  "homepage": "https://github.com/piro0919/next-unused#readme",
  "bugs": {
    "url": "https://github.com/piro0919/next-unused/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-unused": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "madge": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/madge": "5.0.3",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "lefthook": "^2.0.13",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
